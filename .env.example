# Option 1: Google Gemini API (Recommended: 100% free dedicated limits from Google AI Studio, never rate-limited by shared pools)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-flash

# Option 2: OpenRouter API (Free pool with auto-fallback to llama/gemma/qwen if 429 occurs)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMMA_MODEL_NAME=google/gemma-4-26b-a4b-it:free

# Groq API Key (Optional, Recommended for Free Render deployment: provides free ultra-fast Whisper speech-to-text without RAM limits)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
